<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- LOGO DE FOOTBALL STORE -->
        <ImageView
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="@string/descripcion_logo" />

        <!-- NOMBRE DE LA TIENDA -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/titulo_tienda"
            android:textColor="@color/neon_green"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- FRASE PRINCIPAL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="@string/frase_principal"
            android:textColor="@color/text_white"
            android:textSize="25sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- DESCRIPCIÓN DE LA TIENDA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/descripcion_principal"
            android:textColor="@color/text_gray"
            android:textSize="15sp"
            android:gravity="center" />

        <!-- IMAGEN PRINCIPAL DE LA CAMISETA -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="25dp"
            android:background="@color/card_dark"
            android:padding="12dp"
            android:src="@drawable/camiseta_futbol"
            android:scaleType="fitCenter"
            android:contentDescription="@string/descripcion_camiseta_destacada" />

        <!-- BOTÓN PARA ABRIR EL CATÁLOGO -->
        <Button
            android:id="@+id/btnExplorar"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="20dp"
            android:minWidth="240dp"
            android:maxWidth="320dp"
            android:backgroundTint="@color/neon_green"
            android:text="@string/boton_explorar"
            android:textColor="@color/text_dark"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
